[
  {
    "name": "الفاتحة",
    "verses": [
      {
        "id": 1,
        "text": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"
      }
    ]
  },
  {
    "name": "البقرة",
    "verses": [
      {
        "id": 255,
        "text": "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ"
      }
    ]
  },
  {
    "name": "آل عمران",
    "verses": [
      {
        "id": 8,
        "text": "رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا"
      }
    ]
  },
  {
    "name": "النساء",
    "verses": [
      {
        "id": 28,
        "text": "وَخُلِقَ الْإِنسَانُ ضَعِيفًا"
      }
    ]
  },
  {
    "name": "المائدة",
    "verses": [
      {
        "id": 8,
        "text": "اعْدِلُوا هُوَ أَقْرَبُ لِلتَّقْوَىٰ"
      }
    ]
  },
  {
    "name": "الأنعام",
    "verses": [
      {
        "id": 162,
        "text": "قُلْ إِنَّ صَلَاتِي وَنُسُكِي وَمَحْيَايَ وَمَمَاتِي لِلَّهِ رَبِّ الْعَالَمِينَ"
      }
    ]
  },
  {
    "name": "الأعراف",
    "verses": [
      {
        "id": 23,
        "text": "رَبَّنَا ظَلَمْنَا أَنفُسَنَا"
      }
    ]
  },
  {
    "name": "الأنفال",
    "verses": [
      {
        "id": 2,
        "text": "إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ"
      }
    ]
  },
  {
    "name": "التوبة",
    "verses": [
      {
        "id": 51,
        "text": "قُل لَّن يُصِيبَنَا إِلَّا مَا كَتَبَ اللَّهُ لَنَا"
      }
    ]
  },
  {
    "name": "يونس",
    "verses": [
      {
        "id": 57,
        "text": "وَشِفَاءٌ لِّمَا فِي الصُّدُورِ"
      }
    ]
  },
  {
    "name": "هود",
    "verses": [
      {
        "id": 6,
        "text": "وَمَا مِن دَابَّةٍ فِي الْأَرْضِ إِلَّا عَلَى اللَّهِ رِزْقُهَا"
      }
    ]
  },
  {
    "name": "يوسف",
    "verses": [
      {
        "id": 87,
        "text": "لَا تَيْأَسُوا مِن رَّوْحِ اللَّهِ"
      }
    ]
  },
  {
    "name": "الرعد",
    "verses": [
      {
        "id": 28,
        "text": "أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ"
      }
    ]
  },
  {
    "name": "إبراهيم",
    "verses": [
      {
        "id": 7,
        "text": "لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ"
      }
    ]
  },
  {
    "name": "الحجر",
    "verses": [
      {
        "id": 99,
        "text": "وَاعْبُدْ رَبَّكَ حَتَّىٰ يَأْتِيَكَ الْيَقِينُ"
      }
    ]
  },
  {
    "name": "النحل",
    "verses": [
      {
        "id": 18,
        "text": "وَإِن تَعُدُّوا نِعْمَةَ اللَّهِ لَا تُحْصُوهَا"
      }
    ]
  },
  {
    "name": "الإسراء",
    "verses": [
      {
        "id": 82,
        "text": "وَنُنَزِّلُ مِنَ الْقُرْآنِ مَا هُوَ شِفَاءٌ"
      }
    ]
  },
  {
    "name": "الكهف",
    "verses": [
      {
        "id": 10,
        "text": "رَبَّنَا آتِنَا مِن لَّدُنكَ رَحْمَةً"
      }
    ]
  },
  {
    "name": "مريم",
    "verses": [
      {
        "id": 96,
        "text": "سَيَجْعَلُ لَهُمُ الرَّحْمَٰنُ وُدًّا"
      }
    ]
  },
  {
    "name": "طه",
    "verses": [
      {
        "id": 25,
        "text": "رَبِّ اشْرَحْ لِي صَدْرِي"
      }
    ]
  },
  {
    "name": "الأنبياء",
    "verses": [
      {
        "id": 87,
        "text": "لَا إِلَٰهَ إِلَّا أَنتَ سُبْحَانَكَ"
      }
    ]
  },
  {
    "name": "الحج",
    "verses": [
      {
        "id": 77,
        "text": "وَافْعَلُوا الْخَيْرَ لَعَلَّكُمْ تُفْلِحُونَ"
      }
    ]
  },
  {
    "name": "النور",
    "verses": [
      {
        "id": 35,
        "text": "اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ"
      }
    ]
  },
  {
    "name": "الفرقان",
    "verses": [
      {
        "id": 74,
        "text": "رَبَّنَا هَبْ لَنَا مِنْ أَزْوَاجِنَا وَذُرِّيَّاتِنَا قُرَّةَ أَعْيُنٍ"
      }
    ]
  },
  {
    "name": "الشعراء",
    "verses": [
      {
        "id": 83,
        "text": "رَبِّ هَبْ لِي حُكْمًا وَأَلْحِقْنِي بِالصَّالِحِينَ"
      }
    ]
  },
  {
    "name": "القصص",
    "verses": [
      {
        "id": 24,
        "text": "رَبِّ إِنِّي لِمَا أَنزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ"
      }
    ]
  },
  {
    "name": "العنكبوت",
    "verses": [
      {
        "id": 69,
        "text": "وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا"
      }
    ]
  },
  {
    "name": "الروم",
    "verses": [
      {
        "id": 21,
        "text": "وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً"
      }
    ]
  },
  {
    "name": "لقمان",
    "verses": [
      {
        "id": 17,
        "text": "وَاصْبِرْ عَلَىٰ مَا أَصَابَكَ"
      }
    ]
  },
  {
    "name": "السجدة",
    "verses": [
      {
        "id": 16,
        "text": "تَتَجَافَىٰ جُنُوبُهُمْ عَنِ الْمَضَاجِعِ"
      }
    ]
  },
  {
    "name": "الأحزاب",
    "verses": [
      {
        "id": 56,
        "text": "إِنَّ اللَّهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى النَّبِيِّ"
      }
    ]
  }
]
